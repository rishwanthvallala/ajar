# What the relay holds pads, accounts and addresses to, on each plan.
#
# ajar-relay.service reads this as /etc/ajar/limits.env, which every deploy
# installs from here, and then /etc/ajar/relay.env, which no deploy touches:
# a line there overrides the same one here, on that box, at its next
# `systemctl restart ajar-relay` — for when a change cannot wait for a deploy.
# Pages ask the relay (/api/limits), so neither needs a release of the page.
#
# Two plans (crates/ajar-relay/src/plan.rs). FREE_ is everyone not signed in
# and every account not paying; PAID_ is an account named in
# AJAR_PAID_ACCOUNTS — people, so that list is set in /etc/ajar/relay.env on
# the box, never here. A pad is held to its owner's plan (a pad nobody owns,
# to the free one); what an address may add a day, to the writer's.
#
# Sizes are 200MiB, 4GiB or a number of bytes. A name the relay does not read,
# a value it does not take, or a paid limit below the free one fails the
# relay's tests, so it never reaches the box. See docs/dev/operations.md,
# "The storage limits".

# The store's, whatever plans its pads are on: every pad together, well under
# the disk's free space; and how long a pad nobody owns lasts unopened (an
# account's never lapse).
AJAR_PAD_STORE_BYTES=4GiB
AJAR_PAD_LEASE_DAYS=90

# One pad.
AJAR_FREE_PAD_MAX_BYTES=50MiB
AJAR_PAID_PAD_MAX_BYTES=200MiB
AJAR_FREE_PAD_MAX_FILES=500
AJAR_PAID_PAD_MAX_FILES=2000

# A pad's history: how many versions, how many bytes of files they may name
# between them (the newest is kept whatever its size), and how old.
AJAR_FREE_PAD_VERSIONS=10
AJAR_PAID_PAD_VERSIONS=30
AJAR_FREE_PAD_HISTORY_BYTES=50MiB
AJAR_PAID_PAD_HISTORY_BYTES=500MiB
AJAR_FREE_PAD_VERSION_DAYS=14
AJAR_PAID_PAD_VERSION_DAYS=90

# What one address may add to the store in a day. Growth only: an edit that
# leaves a pad the same size or smaller is free.
AJAR_FREE_GROWTH_PER_ADDRESS=256MiB
AJAR_PAID_GROWTH_PER_ADDRESS=1GiB

# A signed-in account: pads it may own, what they may hold together, and how
# many of them may have a name of its choosing.
AJAR_FREE_ACCOUNT_MAX_PADS=10
AJAR_PAID_ACCOUNT_MAX_PADS=50
AJAR_FREE_ACCOUNT_MAX_BYTES=100MiB
AJAR_PAID_ACCOUNT_MAX_BYTES=1GiB
AJAR_FREE_ACCOUNT_MAX_NAMED=1
AJAR_PAID_ACCOUNT_MAX_NAMED=10

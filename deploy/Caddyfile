# TLS, and nothing else.
#
# The relay speaks plain HTTP on loopback; Caddy fetches and renews the
# certificate and forwards everything through. WebSocket upgrades pass without
# configuration — there is no `transport` block or connection-header dance to
# get right, which is most of why Caddy is here rather than nginx.
#
# Put this at /etc/caddy/Caddyfile and `systemctl reload caddy`.

{
	# How long a reload or a stop waits for open connections before closing
	# them. Unset, Caddy waits for ever, and this site holds connections open
	# for hours — terminals, pad rooms, the sandbox's way out — so a reload
	# need never finish. On 4 October one sat for ten minutes with the old
	# config still serving, and every deploy since 2 October had ended in the
	# tunnel timing out at that step: the Caddyfile changes in them, it is most
	# likely, never went live. Whoever is cut off reconnects, as they do after
	# every relay restart.
	grace_period 10s
}

ajar.rishwanth.dev {
	# The relay serves the web client, the join pages, /install.sh and /ws.
	reverse_proxy 127.0.0.1:8787 {
		# Replace rather than append, so a caller cannot prepend its own
		# value. The relay charges per-address limits to what arrives here,
		# and Caddy's default is to append — which left the leftmost element
		# entirely caller-controlled. The relay now reads the rightmost too;
		# this is the half that holds even if that changes.
		header_up X-Forwarded-For {remote_host}

		# A terminal can sit untouched for a long time and must not be
		# hung up on. Caddy's default read timeout is already generous,
		# but say it out loud rather than inherit it.
		transport http {
			read_timeout 24h
			write_timeout 24h
		}
	}

	encode zstd gzip

	header {
		# The web client is self-contained: no CDN, no third-party
		# anything. Say so, so a compromised dependency has nowhere to
		# phone home to.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; font-src 'self' data:; img-src 'self' data:; connect-src 'self' wss://ajar.rishwanth.dev; frame-ancestors 'none'; base-uri 'none'"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		# The session key lives in the URL fragment, which browsers never
		# send anywhere — but a referrer leak of the path alone would
		# still name the session, so send none at all.
		-Server
		# HTTPS only, for a year, once a browser has been here. Caddy
		# redirects plain http already, but the request it redirects has
		# gone out in the clear, where anything on the way can answer it.
		Strict-Transport-Security "max-age=31536000"
	}

	log {
		output file /var/log/caddy/ajar.log {
			roll_size 10MiB
			roll_keep 5
		}
		# Session ids appear in paths. They are not secrets on their own —
		# the key is — but there is no reason to keep them for a year.
		#
		# What is a secret is left out (audit B05): the pad API answers on
		# this site too, and its requests carry a link's code in
		# X-Pad-Code — as good as the link — and the sign-in in Cookie.
		# Caddy blanks Cookie, Set-Cookie and Authorization itself unless
		# told to log credentials, but not a header it has never heard of,
		# so every coded request kept its code here in the clear. Deleted
		# by name, those three as well, so the answer does not rest on a
		# default; and an OAuth callback's one-time code, from its URL.
		format filter {
			wrap json
			fields {
				request>headers>X-Pad-Code delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
				request>uri query {
					delete code
				}
			}
		}
	}
}

# The browser tier: a folder you open, edit and run without an agent anywhere.
#
# A separate origin, not a path on the one above, and that is forced rather
# than chosen. WASIX threads need SharedArrayBuffer, which needs cross-origin
# isolation, which is a property of the whole document — put it on the origin
# the session client lives on and every cross-origin thing that client loads
# has to opt in or vanish silently. A subdomain keeps the blast radius at zero.
code.rishwanth.dev {
	# Everything the runtime needs, and the reason this origin exists.
	header {
		Cross-Origin-Opener-Policy "same-origin"
		Cross-Origin-Embedder-Policy "require-corp"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
		# HTTPS only, for a year: see the same line for ajar.rishwanth.dev.
		Strict-Transport-Security "max-age=31536000"

		# `unsafe-eval` rather than the narrower `wasm-unsafe-eval`, because
		# the Wasmer SDK's worker evaluates a string as JavaScript and fails
		# inside the worker without it — where the error reads as a hang.
		# The tighter policy was tried first and measured to break; this is
		# a real relaxation and the reason for it is here so nobody tightens
		# it back without running the checks.
		#
		# `connect-src https:`, any https site, since 15 October: `curl`,
		# urllib and requests in a pad are made by this page with fetch
		# (pad/src/fetch-bridge.ts), to whatever site a program asks for. It
		# used to name Wasmer's registry and CDN, which packages still come
		# from, and packages.ajar.invalid, where our own say they are (only
		# the service worker answers for it); `https:` covers all three. What
		# this gives up is in docs/dev/security.md, "HTTP through the
		# browser". http stays out: an https page may not fetch it anyway.
		Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-eval' blob: 'sha256-huRNSawQCIrJA7BFNQFHfGUw3jJ4uVqTxVQU2nhRHi8='; worker-src 'self' blob:; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:; connect-src 'self' wss://code.rishwanth.dev https:; frame-src https://preview.rishwanth.dev; frame-ancestors 'none'; base-uri 'none'"
	}

	# The wasm packages are content-addressed by the registry, and the vendored
	# SDK is copied under a folder named for a hash of what is in it
	# (vite.config.ts), so nothing here is worth revalidating — except wisp,
	# which the import map names and the policy above pins by its hash. This is
	# most of what makes a second visit free. The SDK was one folder for every
	# version until 21 October, and a browser that had kept files of the one
	# before 0.18 ran them against 0.18's: no Run started in it again.
	#
	# Except the two lists beside the packages: which file is which package,
	# and what the registry answered for each. They change when a package does,
	# and until 12 October they were kept for a year with the rest — a
	# returning browser held a list naming files a later deploy had removed,
	# and fell back to Wasmer for all of it. They are small, and asked again
	# each visit, an empty 304 when nothing changed.
	@immutable {
		path /assets/* /vendor/* /packages/*
		not path /packages/*.json
	}
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	header /packages/*.json Cache-Control "no-cache"

	# Per-address limits on what the relay never sees — the files Caddy serves
	# off disk, name resolution and the way out — because nothing else can
	# bound them. Needs the plugin build in deploy/caddy; the packaged Caddy
	# refuses this block. Measured and argued in docs/dev/security.md.
	rate_limit {
		# Keyed on the address *and the file*, not the address alone. A first
		# visit fetches each file once and a returning one fetches nothing, so
		# this is "first visits an hour" for every file at once. Keyed on the
		# address alone, the same allowance spent on the Python package in a
		# loop would be many times the bytes.
		#
		# 100: a workshop on one network, in any shape — all in one minute is
		# fine. 30 turned away the thirty-first person behind one address. Not
		# 30 a minute, which is 1,800 an hour: one script could draw 144 GB an
		# hour, and the account runs on credits that close it when spent. Each
		# event is 24 bytes held per address and file for the window, so the
		# number is also memory — see docs/dev/security.md.
		#
		# `file` so only files that exist can make a key — any other path is
		# the page itself — and the file's cleaned path rather than `{path}`,
		# so `//` or `/./` in a URL cannot make a fresh budget of it.
		zone pad_files {
			match {
				path /packages/* /vendor/* /assets/*
				file {
					root /srv/ajar/pad
				}
			}
			key {remote_host}{file_match.relative}
			events 100
			window 1h
		}
		# A first visit resolves four names and `pip install` a few more.
		zone pad_dns {
			match {
				path /dns-query
			}
			key {remote_host}
			events 120
			window 1m
			ipv6_prefix 64
		}
		# One connection per visit. This bounds how fast they arrive; how many
		# stay open is wisp-server.mjs's, eight per address.
		zone pad_wisp {
			match {
				path /wisp /wisp/*
			}
			key {remote_host}
			events 30
			window 1m
			ipv6_prefix 64
		}
		# The plugin labels its metrics by key and never deletes a label, so
		# with them on every address that ever visits is held for good.
		disable_metrics
	}
	handle_errors 429 {
		# The `immutable` header above has already been set on a refused
		# package. Left there, it tells the browser to keep the refusal for a
		# year.
		header Cache-Control "no-store"
		respond "Too many requests from your address. Try again in a few minutes." 429
	}

	# The relay holds the durable folders and routes the peer broadcast.
	handle /api/* {
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	# Signing in with Google or GitHub: out to the provider and back. Without
	# this the callback falls through to the page, which answers 200 with
	# index.html and the sign-in silently goes nowhere. See docs/dev/accounts.md.
	handle /auth/* {
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Forwarded-For {remote_host}
		}
	}
	handle /ws {
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Forwarded-For {remote_host}
			transport http {
				read_timeout 24h
				write_timeout 24h
			}
		}
	}

	# The pad's way out to the network. A sandbox in the browser cannot open a
	# TCP socket, so it opens one WebSocket here and the endpoint behind it
	# makes the real connections — to PyPI and nowhere else. The allowlist
	# lives in deploy/wisp-server.mjs, which is where widening it is a
	# deliberate act. See docs/dev/networking.md.
	# Both spellings: the SDK appends a trailing slash to whatever URL it is
	# given, so a route matching only /wisp lets /wisp/ fall through to the SPA
	# handler, which answers 200 with index.html — and the browser reports that
	# as "handshake failed: unexpected response code 200", which reads like a
	# proxy problem rather than a routing one.
	# Name resolution for the sandbox, proxied rather than pointed at a third
	# party. The SDK resolves over DNS-over-HTTPS with `fetch`, not through the
	# WISP tunnel, so its default — cloudflare-dns.com — is a cross-origin
	# request that `connect-src 'self'` refuses. The failure surfaces inside the
	# sandbox as "Name does not resolve" and in the console as "Failed to
	# fetch", neither of which points at a policy.
	#
	# Same-origin keeps it allowed without widening the policy, and keeps the
	# names a person resolves off a third party's logs. It tells us nothing we
	# do not already see: every hostname comes past /wisp a moment later anyway.
	# Only what DoH actually is. This forwards to a public resolver on behalf of
	# anyone who asks, so the useful question is not who is asking but how much
	# they can make it carry: a query is a few hundred bytes, and anything
	# arriving here with a megabyte attached is using it as something else.
	# How often is bounded by `pad_dns` above.
	@doh {
		path /dns-query
		method GET POST
	}
	handle @doh {
		request_body {
			max_size 4KB
		}
		reverse_proxy https://cloudflare-dns.com {
			header_up Host cloudflare-dns.com
		}
	}
	handle /dns-query {
		respond "this endpoint answers DNS queries, nothing else" 405
	}

	@wisp path /wisp /wisp/*
	handle @wisp {
		reverse_proxy 127.0.0.1:8788 {
			transport http {
				read_timeout 24h
				write_timeout 24h
			}
		}
	}

	# A pad link pasted into Slack, WhatsApp, iMessage or the like: the app
	# that fetches it for a preview reads the page's tags and never runs a
	# script, so the page alone says nothing about the pad. Those fetchers
	# get a page of Open Graph tags from the relay instead (`unfurl` in
	# main.rs) — its name, its files, a line or two of the main one, or that
	# it is private. People get the page as before. Only a path that can be a
	# pad name: nothing under /assets or /api, and nothing with a dot.
	@unfurl {
		header_regexp bot User-Agent (?i)(slackbot|discordbot|twitterbot|facebookexternalhit|facebot|whatsapp|telegrambot|linkedinbot|skypeuripreview|mattermost|redditbot|embedly|iframely|pinterest|applebot|bluesky|mastodon|vkshare|zulip|snapchat|line-poker|google-pagerenderer|microsoftpreview)
		path_regexp pad ^/([A-Za-z0-9][A-Za-z0-9-]{0,63})/?$
	}
	handle @unfurl {
		rewrite * /api/unfurl/{re.pad.1}
		reverse_proxy 127.0.0.1:8787 {
			header_up X-Forwarded-For {remote_host}
		}
	}

	# The privacy policy, at the plain address Google's consent screen links
	# to. A static page in the pad's build; `privacy` is a reserved name, so no
	# pad can ever sit here.
	handle /privacy {
		root * /srv/ajar/pad
		rewrite * /privacy.html
		file_server
	}
	# A file under the asset folders that is not there is not found, rather
	# than the page below: index.html with a 200, and the `immutable` header
	# from above, so a browser kept a page as that script or package for a
	# year. Said not to be kept at all, as a refusal is in `handle_errors`
	# — it may well be there after the next deploy.
	@missing_asset {
		path /assets/* /vendor/* /packages/*
		not file {
			root /srv/ajar/pad
		}
	}
	handle @missing_asset {
		header Cache-Control "no-store"
		respond "not found" 404
	}
	handle {
		root * /srv/ajar/pad
		# The page, and the few files beside it, asked again each visit — an
		# empty 304 when nothing changed. With no Cache-Control a browser
		# keeps a page as long as it guesses, a tenth of the time since it last
		# changed, and a page kept past a deploy asks for scripts the deploy
		# removed and for the SDK the deploy replaced.
		@revalidated not path /assets/* /vendor/* /packages/*
		header @revalidated Cache-Control "no-cache"
		# Any path that is not a file is a folder name, and the page reads
		# it off the URL.
		try_files {path} /index.html
		# `precompressed` rather than leaving it to `encode`: Caddy decides
		# what to compress from the response Content-Type, and it does not
		# know what a `.webc` is — it serves them with no Content-Type at
		# all, so the default match never fires and 72 MB goes out raw. The
		# build writes `.zst` and `.gz` beside each file instead, which also
		# buys zstd -19, a level no server would spend per request.
		file_server {
			precompressed zstd gzip
		}
	}

	# zstd and gzip both: the wasm payloads are the bulk of a cold visit and
	# Wasmer's own CDN serves them with no encoding at all, which is the
	# difference between 59 MB and roughly 16.
	encode zstd gzip

	log {
		output file /var/log/caddy/code.log {
			roll_size 10MiB
			roll_keep 5
		}
		# The pad's API is here: a link's code in X-Pad-Code, the sign-in in
		# Cookie, and the OAuth callback's code in its URL. None of them is
		# kept — see the same block for ajar.rishwanth.dev.
		format filter {
			wrap json
			fields {
				request>headers>X-Pad-Code delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
				request>uri query {
					delete code
				}
			}
		}
	}
}

# Where a server running inside somebody's folder is served from.
#
# A third origin, and it has to be one. The sandbox's HTTP responses are
# whatever a visitor decided to run; served from code.rishwanth.dev they could
# script the pad, read its storage and reach its service worker. On their own
# origin they can do none of that, and the SDK refuses to route anywhere else.
#
# Only two files live here. The page at /.wasmer/host.html registers the
# worker and hands a MessagePort back to the pad; the worker answers requests
# by asking the pad's sandbox over that port. Nothing is stored and nothing is
# proxied — with no pad open, this origin serves a 404 and nothing else.
preview.rishwanth.dev {
	header {
		# The pad is cross-origin isolated, so a document embedded in it
		# must carry this or the browser refuses the frame — and the SDK
		# reports only "the Wasmer HTTP host did not become ready", which
		# reads like slowness rather than a blocked load. This header is
		# the difference between working and that message.
		Cross-Origin-Embedder-Policy "require-corp"
		Cross-Origin-Resource-Policy "cross-origin"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "no-referrer"
		-Server
		# HTTPS only, for a year: see the same line for ajar.rishwanth.dev.
		Strict-Transport-Security "max-age=31536000"

		# Framed by the pad and by nothing else. Whatever the sandbox
		# serves gets `sandbox` besides, so a page someone runs in their
		# folder cannot navigate the top window or run plugins.
		Content-Security-Policy "default-src 'self'; frame-ancestors https://code.rishwanth.dev; base-uri 'none'"
	}

	# The control document: the SDK's script, which connects the pad to the
	# worker, and the pad's, which carries what the preview reports. Inline
	# rather than a file, because it is one line.
	handle /.wasmer/host.html {
		header Content-Type "text/html; charset=utf-8"
		header Cache-Control "no-cache"
		respond `<!doctype html><meta charset="utf-8"><script type="module" src="/wasmer-host.js"></script><script type="module" src="/pad-preview.js"></script>` 200
	}

	# The SDK's half, from the vendored SDK the pad already ships, so it is
	# never a different version from the client talking to it.
	handle /wasmer-host.js {
		header Content-Type "text/javascript; charset=utf-8"
		header Cache-Control "no-cache"
		# Beside the SDK's folder, which is named for its version: one file, with
		# no imports of its own, copied there by the build for this.
		root * /srv/ajar/pad/vendor/wasmer
		rewrite * /service-worker-host.js
		file_server
	}
	# The pad's own: pad/preview/ in the repository, copied by the build.
	# The worker replaces the SDK's, which routes one server and keeps no
	# cookies; it answers the SDK's messages the same way.
	handle /pad-preview.js {
		header Content-Type "text/javascript; charset=utf-8"
		header Cache-Control "no-cache"
		root * /srv/ajar/pad/vendor/preview
		rewrite * /relay.js
		file_server
	}
	handle /wasmer-service-worker.js {
		header Content-Type "text/javascript; charset=utf-8"
		# Without this the worker may only control its own directory, and
		# it needs the root to answer for whatever the guest serves.
		header Service-Worker-Allowed "/"
		header Cache-Control "no-cache"
		root * /srv/ajar/pad/vendor/preview
		rewrite * /sw.js
		file_server
	}

	# Everything else. A request here means a route that no longer exists —
	# the worker holds it in memory and is killed when idle — so say so
	# rather than serving anything.
	handle {
		respond "no preview is running" 404
	}

	encode zstd gzip

	log {
		output file /var/log/caddy/preview.log {
			roll_size 10MiB
			roll_keep 5
		}
		# Nothing of ours should arrive here — the pad's cookie is host-only
		# and its code goes to the pad's origin — but what a page sends is
		# the page's choice, so the same headers are kept out.
		format filter {
			wrap json
			fields {
				request>headers>X-Pad-Code delete
				request>headers>Cookie delete
				request>headers>Authorization delete
				resp_headers>Set-Cookie delete
			}
		}
	}
}

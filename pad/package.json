{
  "name": "ajar-pad",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit && vite build",
    "check": "npm run build && node scripts/browser-check.mjs && node scripts/app-check.mjs && node scripts/terminal-check.mjs && node scripts/user-check.mjs",
    "probe": "npm run build && node scripts/probe-packages.mjs"
  },
  "dependencies": {
    "@ajar/workspace-ui": "0.0.0",
    "@wasm-fmt/clang-format": "23.1.1",
    "@wasm-fmt/gofmt": "0.7.3",
    "@wasm-fmt/lua_fmt": "0.3.3",
    "@wasm-fmt/mago_fmt": "1.44.0",
    "@wasm-fmt/markdown": "0.1.6",
    "@wasm-fmt/ruff_fmt": "0.15.20",
    "@wasm-fmt/shfmt": "0.2.7",
    "@wasm-fmt/sql_fmt": "0.2.2",
    "@wasm-fmt/taplo_fmt": "0.2.5",
    "@wasm-fmt/web_fmt": "0.2.9",
    "@wasm-fmt/yamlfmt": "0.2.1",
    "@wasmer/sdk": "0.18.0",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "dompurify": "3.4.8",
    "jsonc-parser": "3.3.1",
    "marked": "14.0.0",
    "monaco-editor": "^0.55.0",
    "y-protocols": "^1.0.7",
    "yjs": "^13.6.27"
  },
  "devDependencies": {
    "@types/node": "^22.20.2",
    "playwright": "^1.60.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0"
  }
}

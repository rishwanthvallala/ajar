{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "noUncheckedIndexedAccess": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["vite/client", "node"],
    // Monaco publishes `"./*": "./*"`, which the bundler resolver follows for
    // code but not for types — vite builds this import happily while tsc
    // reports it missing. Naming the declaration file directly settles it.
    "paths": {
      "monaco-editor/esm/vs/editor/editor.api": [
        "./node_modules/monaco-editor/esm/vs/editor/editor.api.d.ts"
      ]
    }
  },
  "include": ["src", "vite.config.ts"]
}

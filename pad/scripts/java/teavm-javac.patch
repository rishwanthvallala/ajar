--- a/compiler/build.gradle
+++ b/compiler/build.gradle
@@ -46,9 +46,118 @@ compileJava {
     options.compilerArgs.addAll("--limit-modules", "java.base")
 }
 
+// The JDK's own number parsing and printing, from the JDK the javac comes
+// from, for javac to use instead of TeaVM's class library (ajar; see
+// org.ajar.javac.jdkmath.Internals and Patches.transformNumberText).
+def jdkRevision = providers.gradleProperty("jdk.revision").get()
+def jdkRepo = providers.gradleProperty("jdk.repo").getOrElse("openjdk/jdk25u")
+def jdkRepoName = jdkRepo.substring(jdkRepo.lastIndexOf('/') + 1)
+def jdkMathDir = layout.buildDirectory.dir("generated/jdkmath")
+def copyJdkMath = tasks.register("copyJdkMath", Copy) {
+    dependsOn ":javac:unpackJDK"
+    from(project(":javac").layout.buildDirectory.dir(
+            "jdk/${jdkRepoName}-${jdkRevision}/src/java.base/share/classes/jdk/internal/math")) {
+        include "DoubleConsts.java", "FloatConsts.java", "DoubleToDecimal.java", "FloatToDecimal.java",
+                "ToDecimal.java", "MathUtils.java", "FloatingDecimal.java", "FDBigInteger.java",
+                "FormattedFPDecimal.java"
+    }
+    into jdkMathDir.map { it.dir("org/ajar/javac/jdkmath") }
+    // A filter's code is not an input Gradle sees: bump this when changing it.
+    inputs.property("rules", 2)
+    filter { String line ->
+        if (line.startsWith("import jdk.internal.access.") || line.startsWith("import jdk.internal.misc.")
+                || line.startsWith("import jdk.internal.vm.") || line.startsWith("import sun.nio.cs.")) {
+            return null
+        }
+        line.replace("package jdk.internal.math;", "package org.ajar.javac.jdkmath;")
+                .replace("jdk.internal.math.", "org.ajar.javac.jdkmath.")
+                .replace("import static java.lang.Math.multiplyHigh;",
+                        "import static org.ajar.javac.jdkmath.Internals.multiplyHigh;")
+                .replace("JavaLangAccess JLA = SharedSecrets.getJavaLangAccess();", "Internals JLA = Internals.JLA;")
+                .replace("CDS.initializeFromArchive(FDBigInteger.class);", "")
+                .replace("@Stable", "")
+                .replace("ISO_8859_1.INSTANCE", "java.nio.charset.StandardCharsets.ISO_8859_1")
+                // Java 21's String.indexOf(str, from, to), which TeaVM lacks; the
+                // line before it has already checked the bounds.
+                .replace("in.indexOf(sub, i, high) == i", "in.startsWith(sub, i)")
+    }
+}
+sourceSets.main.java.srcDir(jdkMathDir)
+compileJava.dependsOn(copyJdkMath)
+
+// javac's version bundle, which the JDK's build generates and teavm-javac had
+// not: without it `javac -version` says "version not available" (ajar).
+def versionDir = layout.buildDirectory.dir("generated/version")
+def writeJavacVersion = tasks.register("writeJavacVersion") {
+    def release = providers.gradleProperty("javac.version.release").get()
+    def full = providers.gradleProperty("javac.version.full").get()
+    def out = versionDir.map { it.file("com/sun/tools/javac/resources/version.java") }
+    inputs.property("release", release)
+    inputs.property("full", full)
+    outputs.file out
+    doLast {
+        def file = out.get().asFile
+        file.parentFile.mkdirs()
+        file.text = """package com.sun.tools.javac.resources;
+
+public final class version extends java.util.ListResourceBundle {
+    protected Object[][] getContents() {
+        return new Object[][] { { "jdk", "${release}" }, { "full", "${full}" }, { "release", "${release}" } };
+    }
+}
+"""
+    }
+}
+sourceSets.main.java.srcDir(versionDir)
+compileJava.dependsOn(writeJavacVersion)
+
+// javac's option lists for --help and --help-extra, as this JDK's javac prints
+// them (ajar; see org.ajar.javac.Help). The build runs on that JDK.
+def helpDir = layout.buildDirectory.dir("generated/help")
+def writeHelpText = tasks.register("writeHelpText") {
+    def out = helpDir.map { it.file("org/ajar/javac/HelpText.java") }
+    inputs.property("javac", providers.gradleProperty("javac.version.full").get())
+    outputs.file out
+    doLast {
+        def javac = { String option ->
+            def process = new ProcessBuilder("javac", option).redirectErrorStream(true).start()
+            def text = process.inputStream.getText("UTF-8")
+            if (process.waitFor() != 0) {
+                throw new GradleException("javac ${option} failed: ${text}")
+            }
+            text.readLines()
+        }
+        // --help: two header lines, the list, a blank line. --help-extra: the
+        // list, a blank line, the footer.
+        def standard = javac("--help")
+        standard = standard.subList(2, standard.size() - 1)
+        def extended = javac("--help-extra")
+        extended = extended.subList(0, extended.size() - 2)
+        def literal = { List<String> lines ->
+            '"' + lines.join("\n").replace("\\", "\\\\").replace('"', '\\"').replace("\n", "\\n") + '"'
+        }
+        def file = out.get().asFile
+        file.parentFile.mkdirs()
+        file.text = """package org.ajar.javac;
+
+final class HelpText {
+    static final String STANDARD = ${literal(standard)};
+    static final String EXTENDED = ${literal(extended)};
+
+    private HelpText() {
+    }
+}
+"""
+    }
+}
+sourceSets.main.java.srcDir(helpDir)
+compileJava.dependsOn(writeHelpText)
+
 teavm {
     all {
-        mainClass = "org.teavm.javac.CompilerLib"
+        // The pad's javac only (ajar): TeaVM's own compiler, which turns class
+        // files into Wasm in the browser, is not reachable from it and is left out.
+        mainClass = "org.ajar.javac.PadLib"
     }
     wasmGC {
         outOfProcess = true
diff --git a/compiler/src/main/java/com/sun/tools/javac/main/PadJavac.java b/compiler/src/main/java/com/sun/tools/javac/main/PadJavac.java
new file mode 100644
index 0000000..c1a99cb
--- /dev/null
+++ b/compiler/src/main/java/com/sun/tools/javac/main/PadJavac.java
@@ -0,0 +1,342 @@
+/*
+ * Copyright 2026 the ajar authors.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package com.sun.tools.javac.main;
+
+import com.sun.tools.javac.resources.CompilerProperties.Errors;
+import com.sun.tools.javac.util.Context;
+import com.sun.tools.javac.util.Log;
+import com.sun.tools.javac.util.Log.PrefixKind;
+import com.sun.tools.javac.util.Log.WriterKind;
+import com.sun.tools.javac.util.Options;
+import java.io.PrintWriter;
+import java.io.StringWriter;
+import java.nio.charset.Charset;
+import java.nio.file.Path;
+import java.util.ArrayList;
+import java.util.LinkedHashMap;
+import java.util.LinkedHashSet;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import javax.tools.JavaFileManager;
+import javax.tools.JavaFileObject;
+import javax.tools.StandardLocation;
+import org.ajar.javac.MemoryFileManager;
+
+/**
+ * The javac command line, over a folder the sandbox sent (ajar).
+ *
+ * <p>What javac's Main does for `javac [options] files`, with the parts that
+ * need a real file system done over {@link MemoryFileManager}: options go
+ * through javac's own Option table, so a bad flag, a missing argument and
+ * --help read as they do anywhere; diagnostics are printed by javac's own Log;
+ * the exit status is Main's (0, 1 for errors in the code, 2 for the command
+ * line, 4 for a crash). Annotation processing, plugins and doclint are not
+ * here (teavm-javac removes them), and neither is --release for anything but
+ * the class library that is here.
+ *
+ * <p>In javac's package because its option helper's file and class-name hooks
+ * are package-private.
+ */
+public final class PadJavac {
+    private static final int OK = 0;
+    private static final int ERROR = 1;
+    private static final int CMDERR = 2;
+    private static final int ABNORMAL = 4;
+
+    private final Map<String, byte[]> sdk;
+    private final String release;
+
+    private String cwd = "/";
+    private final List<String> args = new ArrayList<>();
+    private final Map<String, MemoryFileManager.Input> files = new LinkedHashMap<>();
+    private String envClassPath;
+
+    private String stdout = "";
+    private String stderr = "";
+    private Map<String, byte[]> written = Map.of();
+
+    /** The SDK's files by path; the Java version the class library is, as `--release` names it. */
+    public PadJavac(Map<String, byte[]> sdk, String release) {
+        this.sdk = sdk;
+        this.release = release;
+    }
+
+    public void reset() {
+        cwd = "/";
+        args.clear();
+        files.clear();
+        envClassPath = null;
+        stdout = "";
+        stderr = "";
+        written = Map.of();
+    }
+
+    public void setCwd(String cwd) {
+        this.cwd = cwd;
+    }
+
+    public void addArg(String arg) {
+        args.add(arg);
+    }
+
+    public void addFile(String path, byte[] data, long modified) {
+        files.put(path, new MemoryFileManager.Input(data, modified));
+    }
+
+    /** $CLASSPATH, which javac uses when no -cp is given. */
+    public void setEnvClassPath(String value) {
+        envClassPath = value;
+    }
+
+    public String stdout() {
+        return stdout;
+    }
+
+    public String stderr() {
+        return stderr;
+    }
+
+    public Map<String, byte[]> written() {
+        return written;
+    }
+
+    public int run() {
+        var outText = new StringWriter();
+        var errText = new StringWriter();
+        var out = new PrintWriter(outText, true);
+        var err = new PrintWriter(errText, true);
+        var context = new Context();
+        context.put(Log.outKey, out);
+        context.put(Log.errKey, err);
+        var log = Log.instance(context);
+        var fm = new MemoryFileManager(sdk, files, cwd);
+        context.put(JavaFileManager.class, fm);
+        int result;
+        try {
+            result = compile(context, log, fm);
+        } catch (Throwable e) {
+            // As Main reports a compiler crash.
+            log.printLines(PrefixKind.JAVAC, "msg.bug", JavaCompiler.version());
+            e.printStackTrace(log.getWriter(WriterKind.NOTICE));
+            result = ABNORMAL;
+        }
+        log.flush();
+        out.flush();
+        err.flush();
+        stdout = outText.toString();
+        stderr = errText.toString();
+        written = fm.written();
+        return result;
+    }
+
+    private int compile(Context context, Log log, MemoryFileManager fm) {
+        var helper = new Helper(log, Options.instance(context), fm);
+        if (args.isEmpty()) {
+            try {
+                Option.HELP.process(helper, "-help");
+            } catch (Option.InvalidValueException ignore) {
+                // Printing help cannot fail.
+            }
+            return CMDERR;
+        }
+
+        var sources = new ArrayList<JavaFileObject>();
+        var classNames = new LinkedHashSet<String>();
+        var allowed = Option.getJavaCompilerOptions();
+        var it = args.iterator();
+        boolean errors = false;
+        while (it.hasNext() && !errors) {
+            var arg = it.next();
+            try {
+                if (arg.isEmpty()) {
+                    log.error(Errors.InvalidFlag(arg));
+                    errors = true;
+                } else if (arg.equals("--module-version") || arg.startsWith("--module-version=")
+                        || arg.equals("--inherit-runtime-environment")) {
+                    helper.refused = "error: " + arg.replaceAll("=.*", "") + " is not available here";
+                } else if (arg.startsWith("-")) {
+                    var option = Option.lookup(arg, allowed);
+                    if (option == null) {
+                        log.error(Errors.InvalidFlag(arg));
+                        errors = true;
+                    } else {
+                        option.handleOption(helper, arg, it);
+                    }
+                } else if (Option.SOURCEFILE.matches(arg)) {
+                    if (arg.endsWith(".java")) {
+                        var file = fm.commandLineFile(arg);
+                        if (file == null) {
+                            throw helper.newInvalidValueException(Errors.FileNotFound(arg));
+                        }
+                        sources.add(file);
+                    } else {
+                        classNames.add(arg);
+                    }
+                } else {
+                    log.error(Errors.InvalidFlag(arg));
+                    errors = true;
+                }
+            } catch (Option.InvalidValueException e) {
+                log.printRawLines(e.getMessage());
+                errors = true;
+            }
+            if (helper.refused != null) {
+                log.printRawLines(helper.refused);
+                errors = true;
+            }
+        }
+        if (errors) {
+            log.printLines(PrefixKind.JAVAC, "msg.usage", helper.getOwnName());
+            return CMDERR;
+        }
+
+        var options = Options.instance(context);
+        // As Arguments does once the options are in: Log, among others, reads
+        // -Xmaxerrs and -XDrawDiagnostics when told.
+        options.notifyListeners();
+        var release = options.get(Option.RELEASE);
+        if (release != null && !release.equals(this.release)) {
+            log.printRawLines("error: --release " + release + " is not available here: this javac compiles "
+                    + "against Java " + this.release + "'s class library only");
+            return CMDERR;
+        }
+        if (sources.isEmpty() && classNames.isEmpty()) {
+            // It is allowed to compile nothing if just asking for help or version info.
+            if (options.isSet(Option.HELP) || options.isSet(Option.X) || options.isSet(Option.HELP_LINT)
+                    || options.isSet(Option.VERSION) || options.isSet(Option.FULLVERSION)) {
+                return OK;
+            }
+            log.error(Errors.NoSourceFiles);
+            return CMDERR;
+        }
+
+        fm.setClassPath(helper.classPath != null ? helper.classPath
+                : envClassPath != null ? envClassPath : ".");
+        if (helper.sourcePath != null) {
+            fm.setSourcePath(helper.sourcePath);
+        }
+        for (var output : helper.outputs.entrySet()) {
+            fm.setOutput(output.getKey(), output.getValue());
+        }
+
+        var compiler = new PadCompiler(context);
+        compiler.prepare();
+        if (!classNames.isEmpty()) {
+            // javac says this when it sets up annotation processing, which is not here.
+            log.error(Errors.ProcNoExplicitAnnotationProcessingRequested(classNames));
+        }
+        compiler.compile(com.sun.tools.javac.util.List.from(sources), com.sun.tools.javac.util.List.nil(), null,
+                com.sun.tools.javac.util.List.nil());
+        return compiler.errorCount() == 0 ? OK : ERROR;
+    }
+
+    /** javac's compiler, with its unnamed module reading the one module the SDK is. */
+    private static final class PadCompiler extends JavaCompiler {
+        PadCompiler(Context context) {
+            super(context);
+        }
+
+        void prepare() {
+            syms.unnamedModule.visiblePackages = new LinkedHashMap<>();
+            syms.unnamedModule.readModules = Set.of(syms.unnamedModule, syms.java_base);
+            syms.java_base.complete();
+            for (var export : syms.java_base.exports) {
+                syms.unnamedModule.visiblePackages.put(export.packge.fullname, export.packge);
+            }
+        }
+    }
+
+    /** Options into javac's Options; the file manager's into the folder's. */
+    private static final class Helper extends OptionHelper {
+        private final Log log;
+        private final Options options;
+        private final MemoryFileManager fm;
+        String classPath;
+        String sourcePath;
+        final Map<JavaFileManager.Location, String> outputs = new LinkedHashMap<>();
+        String refused;
+
+        Helper(Log log, Options options, MemoryFileManager fm) {
+            this.log = log;
+            this.options = options;
+            this.fm = fm;
+        }
+
+        @Override
+        public String get(Option option) {
+            return options.get(option);
+        }
+
+        @Override
+        public void put(String name, String value) {
+            options.put(name, value);
+        }
+
+        @Override
+        public void remove(String name) {
+            options.remove(name);
+        }
+
+        @Override
+        public boolean handleFileManagerOption(Option option, String value) {
+            switch (option) {
+                case CLASS_PATH -> classPath = value;
+                case SOURCE_PATH -> sourcePath = value;
+                case D -> outputs.put(StandardLocation.CLASS_OUTPUT, value);
+                case S -> outputs.put(StandardLocation.SOURCE_OUTPUT, value);
+                case H -> outputs.put(StandardLocation.NATIVE_HEADER_OUTPUT, value);
+                case ENCODING -> {
+                    try {
+                        fm.setEncoding(Charset.forName(value));
+                    } catch (RuntimeException e) {
+                        refused = "error: unsupported encoding: " + value;
+                    }
+                }
+                default -> refused = "error: " + option.primaryName + " is not available here";
+            }
+            return true;
+        }
+
+        @Override
+        public Log getLog() {
+            return log;
+        }
+
+        @Override
+        public String getOwnName() {
+            return "javac";
+        }
+
+        @Override
+        public void initialize() {
+            // As Arguments' helper does: Options otherwise takes an option read
+            // before it is set for one never set, and asserts so later.
+            options.initialize();
+        }
+
+        @Override
+        void addFile(Path p) {
+            // Source files are handled before an option ever sees them.
+            throw new IllegalStateException(p.toString());
+        }
+
+        @Override
+        void addClassName(String s) {
+            throw new IllegalStateException(s);
+        }
+    }
+}

@@ -0,0 +1,57 @@
+/*
+ * Copyright 2026 the ajar authors.
+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.ajar.javac.jdkmath;
+
+/**
+ * What the JDK's jdk.internal.math classes reach for outside themselves.
+ *
+ * <p>The rest of this package is copied from the JDK the javac comes from, at
+ * build time (compiler/build.gradle, {@code copyJdkMath}), so javac parses and
+ * prints numbers exactly as the JDK does rather than as TeaVM's class library
+ * does. The JDK's code asks {@code SharedSecrets} for UTF-16 string internals
+ * and uses {@code Math.multiplyHigh}; these stand in. The UTF-16 paths serve
+ * the JDK's own StringBuilder and are not reached here; they only have to agree
+ * with each other.
+ */
+final class Internals {
+    static final Internals JLA = new Internals();
+
+    private Internals() {
+    }
+
+    void uncheckedPutCharUTF16(byte[] str, int index, int c) {
+        str[index << 1] = (byte) c;
+        str[(index << 1) + 1] = (byte) (c >> 8);
+    }
+
+    char uncheckedGetUTF16Char(byte[] str, int index) {
+        return (char) ((str[index << 1] & 0xFF) | ((str[(index << 1) + 1] & 0xFF) << 8));
+    }
+
+    /** {@link Math#multiplyHigh}, as the JDK computes it without an intrinsic. */
+    static long multiplyHigh(long x, long y) {
+        long x1 = x >> 32;
+        long x2 = x & 0xFFFFFFFFL;
+        long y1 = y >> 32;
+        long y2 = y & 0xFFFFFFFFL;
+        long z2 = x2 * y2;
+        long t = x1 * y2 + (z2 >>> 32);
+        long z1 = t & 0xFFFFFFFFL;
+        long z0 = t >> 32;
+        z1 += x2 * y1;
+        return x1 * y1 + z0 + (z1 >> 32);
+    }
+}

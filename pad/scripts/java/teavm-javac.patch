+ */
+package org.ajar.javac;
+
+import java.io.ByteArrayInputStream;
+import java.io.IOException;
+import java.util.LinkedHashMap;
+import org.teavm.javac.ArchiveReader;
+import org.teavm.jso.JSExport;
+import org.teavm.jso.typedarrays.Int8Array;
+
+/**
+ * The module's one export: a javac for the pad (ajar). The JavaScript side
+ * makes one per page, given the SDK — the class library to compile against, in
+ * teavm-javac's archive format — and runs it once per `javac` the sandbox asks
+ * for. See {@link Javac}.
+ */
+public final class PadLib {
+    private PadLib() {
+    }
+
+    @JSExport
+    public static Javac createJavac(Int8Array sdk, String release) throws IOException {
+        var files = new LinkedHashMap<String, byte[]>();
+        try (var input = new ArchiveReader(new ByteArrayInputStream(sdk.copyToJavaArray()))) {
+            String name;
+            while ((name = input.readNext()) != null) {
+                files.put(name, input.readData());
+            }
+        }
+        return new Javac(new com.sun.tools.javac.main.PadJavac(files, release));
+    }
+}

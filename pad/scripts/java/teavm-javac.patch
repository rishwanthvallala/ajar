+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.ajar.javac;
+
+import java.math.BigDecimal;
+
+/**
+ * The arithmetic javac's constant folding does, as a JVM does it.
+ *
+ * <p>Compiled to Wasm by TeaVM, an integer division by zero or of MIN_VALUE by
+ * -1 traps instead of throwing — ConstFold catches ArithmeticException to
+ * leave {@code 1 / 0} for run time, so the trap took javac down — and floating
+ * point {@code %} is not exact. Patches.java points ConstFold's divisions,
+ * remainders and negations here.
+ */
+public final class Exact {
+    private Exact() {
+    }
+
+    public static int idiv(int a, int b) {
+        if (b == 0) {
+            throw new ArithmeticException("/ by zero");
+        }
+        return b == -1 ? -a : a / b;
+    }
+
+    public static int irem(int a, int b) {
+        if (b == 0) {
+            throw new ArithmeticException("/ by zero");
+        }
+        return b == -1 ? 0 : a % b;
+    }
+
+    public static long ldiv(long a, long b) {
+        if (b == 0) {
+            throw new ArithmeticException("/ by zero");
+        }
+        return b == -1 ? -a : a / b;
+    }
+
+    public static long lrem(long a, long b) {
+        if (b == 0) {
+            throw new ArithmeticException("/ by zero");
+        }
+        return b == -1 ? 0 : a % b;
+    }
+
+    /** {@code a % b} as the JLS defines it: exact, with the sign of {@code a}. */
+    public static double drem(double a, double b) {
+        if (Double.isNaN(a) || Double.isNaN(b) || Double.isInfinite(a) || b == 0) {
+            return Double.NaN;
+        }
+        if (Double.isInfinite(b) || a == 0) {
+            return a;
+        }
+        // Both are exact as decimals, and so is the remainder, which is also
+        // exactly a double: no rounding happens anywhere.
+        double r = new BigDecimal(a).remainder(new BigDecimal(b)).doubleValue();
+        return r == 0 ? (a < 0 ? -0.0 : 0.0) : r;
+    }
+
+    /** The float remainder is exact in double too, so it is computed there. */
+    public static float frem(float a, float b) {
+        return (float) drem(a, b);
+    }
+
+    public static double dneg(double a) {
+        return Double.longBitsToDouble(Double.doubleToRawLongBits(a) ^ Long.MIN_VALUE);
+    }
+
+    public static float fneg(float a) {
+        return Float.intBitsToFloat(Float.floatToRawIntBits(a) ^ Integer.MIN_VALUE);
+    }
+}

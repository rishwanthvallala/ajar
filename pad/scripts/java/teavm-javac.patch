+ *
+ * Licensed under the Apache License, Version 2.0 (the "License");
+ * you may not use this file except in compliance with the License.
+ * You may obtain a copy of the License at
+ *
+ *     http://www.apache.org/licenses/LICENSE-2.0
+ *
+ * Unless required by applicable law or agreed to in writing, software
+ * distributed under the License is distributed on an "AS IS" BASIS,
+ * WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied.
+ * See the License for the specific language governing permissions and
+ * limitations under the License.
+ */
+package org.ajar.javac;
+
+import java.io.ByteArrayInputStream;
+import java.io.ByteArrayOutputStream;
+import java.io.IOException;
+import java.io.InputStream;
+import java.io.InputStreamReader;
+import java.io.OutputStream;
+import java.io.OutputStreamWriter;
+import java.io.Reader;
+import java.io.Writer;
+import java.net.URI;
+import java.nio.charset.Charset;
+import java.nio.charset.StandardCharsets;
+import java.util.ArrayList;
+import java.util.Collections;
+import java.util.HashMap;
+import java.util.LinkedHashMap;
+import java.util.List;
+import java.util.Map;
+import java.util.Set;
+import java.util.zip.ZipEntry;
+import java.util.zip.ZipInputStream;
+import javax.lang.model.element.Modifier;
+import javax.lang.model.element.NestingKind;
+import javax.tools.FileObject;
+import javax.tools.JavaFileManager;
+import javax.tools.JavaFileObject;
+import javax.tools.StandardLocation;
+
+/**
+ * A folder as javac sees it, from the files the sandbox sent: each at its
+ * absolute path, with what the class path, source path and output directories
+ * were given as. It answers as javac's own file manager does for `javac -d out
+ * -cp lib Main.java`: a class on the class path is found in its package's
+ * directory under each entry in turn, a source file there too when there is
+ * no source path, and a class file goes under -d, or beside its source file.
+ * The class library is the SDK, as module java.base.
+ */
+public final class MemoryFileManager implements JavaFileManager {
+    /** A file the sandbox sent. */
+    public record Input(byte[] data, long modified) {
+    }
+
+    /** A class path or source path entry: a directory, or a jar's entries. */
+    private record Root(String path, String given, Map<String, byte[]> jar) {
+    }
+
+    private static final Map<String, JavaFileObject.Kind> KINDS = new HashMap<>();
+
+    static {
+        for (var kind : JavaFileObject.Kind.values()) {
+            if (!kind.extension.isEmpty()) {
+                KINDS.put(kind.extension, kind);
+            }
+        }
+    }
+
+    private final Map<String, MemoryFile> platform;
+    private final Map<String, Input> disk;
+    private final String cwd;
+    private final Map<String, MemoryFile> written = new LinkedHashMap<>();
+    private List<Root> classPath = List.of();
+    private List<Root> sourcePath;
+    private final Map<JavaFileManager.Location, String> outputs = new HashMap<>();
+    private Charset charset = StandardCharsets.UTF_8;
+
+    public MemoryFileManager(Map<String, byte[]> sdk, Map<String, Input> disk, String cwd) {
+        this.platform = new HashMap<>();
+        for (var entry : sdk.entrySet()) {
+            var file = new MemoryFile(entry.getKey(), entry.getKey(), binaryName(entry.getKey()), entry.getValue(), 0);
+            file.javaBase = true;
+            platform.put(entry.getKey(), file);
+        }
+        this.disk = disk;
+        this.cwd = cwd;
+    }
+
+    // ---- what the command line set up ----
+
+    /** A path as the program gave it, made absolute against the folder it ran in. */
+    public String resolve(String path) {
+        var full = path.startsWith("/") ? path : cwd + "/" + path;
+        var parts = new ArrayList<String>();
+        for (var part : full.split("/")) {
+            if (part.isEmpty() || part.equals(".")) {
+                continue;
+            }
+            if (part.equals("..")) {
+                if (!parts.isEmpty()) {
+                    parts.remove(parts.size() - 1);
+                }
+                continue;
+            }
+            parts.add(part);
+        }
+        return "/" + String.join("/", parts);
+    }
+
+    public void setClassPath(String value) {
+        classPath = roots(value);
+    }
+
+    public void setSourcePath(String value) {
+        sourcePath = roots(value);
+    }
+
+    public void setOutput(JavaFileManager.Location location, String dir) {
+        outputs.put(location, resolve(dir));
+    }
+
+    public void setEncoding(Charset charset) {
+        this.charset = charset;
+    }
+
+    private List<Root> roots(String value) {
+        var roots = new ArrayList<Root>();
+        for (var entry : value.split(":", -1)) {
+            // An empty entry is the current directory, as on any JVM.
+            var given = entry.isEmpty() ? "." : entry;
+            var path = resolve(given);
+            Map<String, byte[]> jar = null;
+            var input = disk.get(path);
+            if (input != null && (path.endsWith(".jar") || path.endsWith(".zip"))) {
+                jar = readJar(input.data());
+            }
+            roots.add(new Root(path, given, jar));
+        }
+        return roots;
+    }
+
+    private static Map<String, byte[]> readJar(byte[] data) {
+        var entries = new LinkedHashMap<String, byte[]>();
+        try (var zip = new ZipInputStream(new ByteArrayInputStream(data))) {
+            ZipEntry entry;
+            while ((entry = zip.getNextEntry()) != null) {
+                if (!entry.isDirectory()) {
+                    entries.put(entry.getName(), zip.readAllBytes());
+                }
+            }
+        } catch (IOException e) {
+            // An unreadable jar contributes nothing, as javac's would.
+        }
+        return entries;
+    }
+
+    /** A source file named on the command line, or null when there is none. */
+    public JavaFileObject commandLineFile(String given) {
+        var path = resolve(given);
+        var input = disk.get(path);
+        if (input == null) {
+            return null;
+        }
+        return new MemoryFile(path, given, null, input.data(), input.modified());
+    }
+
+    /** What javac wrote, by absolute path. */
+    public Map<String, byte[]> written() {
+        var result = new LinkedHashMap<String, byte[]>();
+        for (var entry : written.entrySet()) {
+            result.put(entry.getKey(), entry.getValue().data);
+        }
+        return result;
+    }
+
+    // ---- javac's questions ----
+
+    private List<Root> rootsOf(JavaFileManager.Location location) {
+        if (location == StandardLocation.CLASS_PATH) {
+            return classPath;
+        }
+        if (location == StandardLocation.SOURCE_PATH) {
+            return sourcePath != null ? sourcePath : List.of();
+        }
+        return List.of();
+    }
+
+    @Override
+    public ClassLoader getClassLoader(JavaFileManager.Location location) {
+        return MemoryFileManager.class.getClassLoader();
+    }
+
+    @Override
+    public Iterable<JavaFileObject> list(JavaFileManager.Location location, String packageName,
+            Set<JavaFileObject.Kind> kinds, boolean recurse) {
+        var pkg = packageName.replace('.', '/');
+        var result = new ArrayList<JavaFileObject>();
+        if (location == StandardLocation.PLATFORM_CLASS_PATH) {
+            for (var file : platform.values()) {
+                if (within(file.path, pkg, recurse) && kinds.contains(file.getKind())) {
+                    result.add(file);
+                }
+            }
+            return result;
+        }
+        // Each entry in order, so the first one with a class is the one used.
+        for (var root : rootsOf(location)) {
+            if (root.jar != null) {
+                for (var entry : root.jar.entrySet()) {
+                    if (within(entry.getKey(), pkg, recurse) && kinds.contains(kindOf(entry.getKey()))) {
+                        result.add(new MemoryFile(root.path + "(" + entry.getKey() + ")",
+                                root.given + "(" + entry.getKey() + ")", binaryName(entry.getKey()),
+                                entry.getValue(), 0));
+                    }
+                }
+                continue;
+            }
+            var prefix = root.path.equals("/") ? "" : root.path;
+            var names = new ArrayList<String>();
+            for (var path : disk.keySet()) {
+                if (path.startsWith(prefix + "/")) {
+                    var relative = path.substring(prefix.length() + 1);
+                    if (within(relative, pkg, recurse) && kinds.contains(kindOf(relative))) {
+                        names.add(relative);
+                    }
+                }
+            }
+            Collections.sort(names);
+            for (var relative : names) {
+                var input = disk.get(prefix + "/" + relative);
+                result.add(new MemoryFile(prefix + "/" + relative, join(root.given, relative),
+                        binaryName(relative), input.data(), input.modified()));
+            }
+        }
+        return result;
+    }
+
+    /** Whether a path is in a package — directly, or anywhere below it. */
+    private static boolean within(String path, String pkg, boolean recurse) {
+        if (!pkg.isEmpty()) {
+            if (!path.startsWith(pkg + "/")) {
+                return false;
+            }
+            path = path.substring(pkg.length() + 1);
+        }
+        return recurse || path.indexOf('/') < 0;
+    }
+
+    /** A path as javac names it: the entry as given, then the file below it. */
+    private static String join(String given, String relative) {
+        return given.endsWith("/") ? given + relative : given + "/" + relative;
+    }
+
+    private static JavaFileObject.Kind kindOf(String path) {
+        var dot = path.lastIndexOf('.');
+        var kind = dot < 0 ? null : KINDS.get(path.substring(dot));
+        return kind != null ? kind : JavaFileObject.Kind.OTHER;
+    }
+
+    private static String binaryName(String relative) {
+        var dot = relative.lastIndexOf('.');
+        return (dot < 0 ? relative : relative.substring(0, dot)).replace('/', '.');
+    }
+
+    @Override
+    public String inferBinaryName(JavaFileManager.Location location, JavaFileObject file) {
+        return file instanceof MemoryFile memory ? memory.binaryName : null;
+    }
+
+    @Override
+    public boolean isSameFile(FileObject a, FileObject b) {
+        return a instanceof MemoryFile x && b instanceof MemoryFile y && x.path.equals(y.path);
+    }
+
+    @Override
+    public boolean handleOption(String current, java.util.Iterator<String> remaining) {
+        return false;
+    }
+
+    @Override
+    public boolean hasLocation(JavaFileManager.Location location) {
+        if (location == StandardLocation.PLATFORM_CLASS_PATH || location == StandardLocation.CLASS_PATH
+                || location == StandardLocation.CLASS_OUTPUT) {
+            return true;
+        }
+        if (location == StandardLocation.SOURCE_PATH) {
+            return sourcePath != null;
+        }
+        return outputs.containsKey(location);
+    }
+
+    @Override
+    public JavaFileObject getJavaFileForInput(JavaFileManager.Location location, String className,
+            JavaFileObject.Kind kind) {
+        return getFileForInput(location, "", className.replace('.', '/') + kind.extension);
+    }
+
+    @Override
+    public MemoryFile getFileForInput(JavaFileManager.Location location, String packageName,
+            String relativeName) {
+        var relative = packageName.isEmpty() ? relativeName : packageName.replace('.', '/') + "/" + relativeName;
+        if (location == StandardLocation.PLATFORM_CLASS_PATH) {
+            return platform.get(relative);
+        }
+        for (var root : rootsOf(location)) {
+            if (root.jar != null) {
+                var data = root.jar.get(relative);
+                if (data != null) {
+                    return new MemoryFile(root.path + "(" + relative + ")", root.given + "(" + relative + ")",
+                            binaryName(relative), data, 0);
+                }
+                continue;
+            }
+            var path = (root.path.equals("/") ? "" : root.path) + "/" + relative;
+            var input = disk.get(path);
+            if (input != null) {
+                return new MemoryFile(path, join(root.given, relative), binaryName(relative), input.data(),
+                        input.modified());
+            }
+        }
+        return null;
+    }
+
+    @Override
+    public JavaFileObject getJavaFileForOutput(JavaFileManager.Location location, String className,
+            JavaFileObject.Kind kind, FileObject sibling) {
+        var dir = outputs.get(location);
+        String path;
+        if (dir != null) {
+            path = (dir.equals("/") ? "" : dir) + "/" + className.replace('.', '/') + kind.extension;
+        } else {
+            // No -d: beside the source it came from, as javac does it.
+            var simple = className.substring(className.lastIndexOf('.') + 1);
+            var beside = sibling instanceof MemoryFile memory && memory.path.startsWith("/")
+                    ? memory.path.substring(0, memory.path.lastIndexOf('/'))
+                    : cwd;
+            path = (beside.equals("/") ? "" : beside) + "/" + simple + kind.extension;
+        }
+        var file = new MemoryFile(path, path, className, new byte[0], 0);
+        file.output = true;
+        return file;
+    }
+
+    @Override
+    public FileObject getFileForOutput(JavaFileManager.Location location, String packageName,
+            String relativeName, FileObject sibling) {
+        var dir = outputs.getOrDefault(location, cwd);
+        var relative = packageName.isEmpty() ? relativeName : packageName.replace('.', '/') + "/" + relativeName;
+        var path = (dir.equals("/") ? "" : dir) + "/" + relative;
+        var file = new MemoryFile(path, path, null, new byte[0], 0);
+        file.output = true;
+        return file;
+    }
+
+    @Override
+    public void flush() {
+    }
+
+    @Override
+    public void close() {
+    }
+
+    @Override
+    public int isSupportedOption(String option) {
+        return -1;
+    }
+
+    @Override
+    public Iterable<Set<JavaFileManager.Location>> listLocationsForModules(JavaFileManager.Location location) {
+        return List.of(Set.of(StandardLocation.PLATFORM_CLASS_PATH));
+    }
+
+    @Override
+    public JavaFileManager.Location getLocationForModule(JavaFileManager.Location location, String moduleName) {
+        return moduleName.equals("java.base") ? StandardLocation.PLATFORM_CLASS_PATH : null;
+    }
+
+    @Override
+    public JavaFileManager.Location getLocationForModule(JavaFileManager.Location location, JavaFileObject fo) {
+        return fo instanceof MemoryFile file && file.javaBase ? StandardLocation.PLATFORM_CLASS_PATH : null;
+    }
+
+    @Override
+    public String inferModuleName(JavaFileManager.Location location) {
+        return location == StandardLocation.PLATFORM_CLASS_PATH ? "java.base" : null;
+    }
+
+    @Override
+    public boolean contains(JavaFileManager.Location location, FileObject fo) {
+        return fo instanceof MemoryFile file && (location == StandardLocation.PLATFORM_CLASS_PATH) == file.javaBase;
+    }
+
+    /** One file: read from the sandbox, from the SDK, or being written. */
+    final class MemoryFile implements JavaFileObject {
+        final String path;
+        final String name;
+        final String binaryName;
+        byte[] data;
+        final long modified;
+        boolean javaBase;
+        boolean output;
+
+        MemoryFile(String path, String name, String binaryName, byte[] data, long modified) {
+            this.path = path;
+            this.name = name;
+            this.binaryName = binaryName;
+            this.data = data;
+            this.modified = modified;
+        }
+
+        @Override
+        public Kind getKind() {
+            return kindOf(path);
+        }
+
+        @Override
+        public boolean isNameCompatible(String simpleName, Kind kind) {
+            var base = path.substring(path.lastIndexOf('/') + 1);
+            return kind == getKind() && base.equals(simpleName + kind.extension);
+        }
+
+        @Override
+        public NestingKind getNestingKind() {
+            return null;
+        }
+
+        @Override
+        public Modifier getAccessLevel() {
+            return null;
+        }
+
+        @Override
+        public URI toUri() {
+            try {
+                return new URI("file", null, path.startsWith("/") ? path : "/" + path, null);
+            } catch (java.net.URISyntaxException e) {
+                throw new IllegalStateException(e);
+            }
+        }
+
+        @Override
+        public String getName() {
+            return name;
+        }
+
+        @Override
+        public InputStream openInputStream() {
+            return new ByteArrayInputStream(data);
+        }
+
+        @Override
+        public OutputStream openOutputStream() {
+            return new ByteArrayOutputStream() {
+                @Override
+                public void close() throws IOException {
+                    super.close();
+                    data = toByteArray();
+                    written.put(path, MemoryFile.this);
+                }
+            };
+        }
+
+        @Override
+        public Reader openReader(boolean ignoreEncodingErrors) {
+            return new InputStreamReader(openInputStream(), charset);
+        }
+
+        @Override
+        public CharSequence getCharContent(boolean ignoreEncodingErrors) {
+            return new String(data, charset);
+        }
+
+        @Override
+        public Writer openWriter() {
+            return new OutputStreamWriter(openOutputStream(), charset);
+        }
+
+        @Override
+        public long getLastModified() {
+            return modified;
+        }
+
+        @Override
+        public boolean delete() {
+            return written.remove(path) != null;
+        }
+
+        @Override
+        public boolean equals(Object other) {
+            return other instanceof MemoryFile file && file.path.equals(path);
+        }
+
+        @Override
+        public int hashCode() {
+            return path.hashCode();
+        }
+
+        @Override
+        public String toString() {
+            return name;
+        }
+    }
+}

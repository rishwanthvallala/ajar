+/// Compile a source file in memory, returning the class to run and the compiled classes.
+///
+/// The class to run is the one named after the file, which is also what javac names the class of
+/// a compact source file; otherwise it is the file's only top-level class.
+async fn compile_source_file(path: &Path) -> Result<(String, Memory)> {
+    let source = std::fs::read_to_string(path)
+        .map_err(|error| InternalError(format!("error: can't read {}: {error}", path.display())))?;
+    let stem = path
+        .file_stem()
+        .map(|stem| stem.to_string_lossy().into_owned())
+        .unwrap_or_default();
+    let compiler = Compiler::new(ConfigurationBuilder::new().build()?)
+        .await
+        .map_err(|error| InternalError(error.to_string()))?;
+    let Ok(classes) = compiler
+        .compile_source_with_options(&stem, &source, &["-proc:none"])
+        .await
+    else {
+        // javac has printed its diagnostics.
+        eprintln!("error: compilation failed");
+        std::process::exit(1);
+    };
+    // The compiler's VM is done; drop it before the program's starts.
+    drop(compiler);
+    let main_class = if classes.get(&stem).is_some() {
+        stem
+    } else {
+        let mut top_level = classes.iter().map(|(name, _)| name).filter(|name| !name.contains('$'));
+        match (top_level.next(), top_level.next()) {
+            (Some(name), None) => name.to_string(),
+            _ => {
+                eprintln!("error: no class named {stem} declared in {}", path.display());
+                std::process::exit(1);
+            }
+        }
+    };
+    let memory = Memory::new("source");
+    classes
+        .load_into(&memory)
+        .await
+        .map_err(|error| InternalError(error.to_string()))?;
+    Ok((main_class, memory))
+}
